---
import Header from "@components/Header.astro";
import "@styles/main.css";
import { Font } from "astro:assets";
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>DIN TITEL HER. MÅSKE SOM PROP?</title>
    <Font cssVariable="--font-cabin" preload />
    <Font cssVariable="--font-lato" preload />
    <style is:inline>
      @layer reset, global, tokens, components, overrides;
    </style>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <footer>Footer</footer>
  </body>
</html>

<style is:global>
  body {
    display: grid;
    align-items: start;
    grid-template-rows: auto 1fr auto;
    grid-template-columns:
      [full-start]
      minmax(1rlh, 1fr)
      [content-start]
      minmax(0, 37.5rem)
      [center]
      minmax(0, 37.5rem)
      [content-end]
      minmax(1rlh, 1fr)
      [full-end];

    > * {
      grid-column: full;
      display: grid;
      grid-template-columns: subgrid;
    }
  }
  @scope (body) to (main) {
    header,
    footer {
      > * {
        grid-column: content;
      }
    }
  }
</style>
