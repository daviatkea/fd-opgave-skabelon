---
import Button from "./Button.astro";
const { id, label } = Astro.props;
---

<Button popovertarget={id} variant="accent">{label}</Button>

<div popover id={id}>
  <slot />
</div>

<style>
  [popover] {
    --move: 0 15%;
    --opacity: 0;

    transition: 0.5s allow-discrete;
    transition-timing-function: linear(
      0,
      0.013 1%,
      0.051 2.2%,
      0.404 9.8%,
      0.51 12.6%,
      0.602 15.5%,
      0.683 18.7%,
      0.754 22.2%,
      0.813 26%,
      0.861 30.2%,
      0.9 34.8%,
      0.931 40%,
      0.972 52.7%,
      0.992 70.2%,
      1
    );
    border-radius: 1.25rem;
    background: var(--color-surface-secondary, #f9fafb);
    box-shadow: 0 8px 12px 0 rgba(0, 0, 0, 0.1);
    border: 1px solid var(--color-neutrals-100);
    translate: var(--move);
    opacity: var(--opacity);
    position-area: bottom;

    &::backdrop {
      opacity: var(--opacity);
      background: #0005;
      transition: 0.5s allow-discrete;
    }

    &:popover-open,
    &:popover-open::backdrop {
      --move: none;
      --opacity: 1;
      @starting-style {
        --move: 0 15%;
        --opacity: 0;
      }
    }
  }

  [popover]:popover-open {
    form > :global(*) {
      transition: 0.5s;
      transition-delay: calc(sibling-index() * 0.1s);
      transition-timing-function: linear(
        0,
        0.013 1%,
        0.051 2.2%,
        0.404 9.8%,
        0.51 12.6%,
        0.602 15.5%,
        0.683 18.7%,
        0.754 22.2%,
        0.813 26%,
        0.861 30.2%,
        0.9 34.8%,
        0.931 40%,
        0.972 52.7%,
        0.992 70.2%,
        1
      );
      @starting-style {
        translate: 0 2rem;
        opacity: 0;
      }
    }
  }
</style>
