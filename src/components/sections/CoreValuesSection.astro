---
import Button from "@components/ui/Button.astro";
import CoreValueCard from "@components/cards/CoreValueCard.astro";
import Grid from "@components/layout/Grid.astro";
import Section from "@components/layout/Section.astro";
import SectionIntro from "@components/content/SectionIntro.astro";
import { getCoreValuesData } from "@lib/api";
const { theme = "muted" } = Astro.props;
const coreValuesData = await getCoreValuesData();
const { title, subtitle, eyebrow, button, values } = coreValuesData;
---

<Section theme={theme}>
  <SectionIntro title={title} subtitle={subtitle} eyebrow={eyebrow}>
    <Button slot="actions">{button.text}</Button>
  </SectionIntro>
  <Grid cols="4">
    {values.map((card) => <CoreValueCard {...card} />)}
  </Grid>
</Section>
