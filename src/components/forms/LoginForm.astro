---
import Button from "@components/ui/Button.astro";
---

<form>
  <h2>Dashboard Login</h2>
  <div class="form-group">
    <label for="email">Email</label>
    <input type="email" />
  </div>
  <div class="form-group">
    <label for="email">Password</label>
    <input type="password" />
  </div>
  <Button disabled>Submit</Button>
</form>

<style>
  form {
    padding: 1rlh;
    display: grid;
    gap: 1rlh;
  }
  .form-group {
    display: grid;
    gap: 0.1rlh;
  }

  form > * {
    transition: 0.5s;
    transition-delay: calc(sibling-index() * 0.1s);
    transition-timing-function: linear(
      0,
      0.013 1%,
      0.051 2.2%,
      0.404 9.8%,
      0.51 12.6%,
      0.602 15.5%,
      0.683 18.7%,
      0.754 22.2%,
      0.813 26%,
      0.861 30.2%,
      0.9 34.8%,
      0.931 40%,
      0.972 52.7%,
      0.992 70.2%,
      1
    );
    @starting-style {
      translate: 0 2rem;
      opacity: 0;
    }
  }
</style>
