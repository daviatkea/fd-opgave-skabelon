---
const { href, variant = "primary", ...props } = Astro.props;
---

{
  href ? (
    <a data-variant={variant} {href}>
      <slot />
    </a>
  ) : (
    <button data-variant={variant} {...props}>
      <slot />
    </button>
  )
}

<style>
  a,
  button {
    padding: 0.5rlh;
    text-box: cap alphabetic;
    background: var(--color-ui-primary);
    color: contrast-color(var(--color-ui-primary));

    @container style(--theme: dark) {
      color: var(--color-ui-primary);
      background: contrast-color(var(--color-ui-primary));
    }
  }
  [data-variant="accent"] {
    background: var(--color-action);
    color: contrast-color(var(--color-action));
  }
</style>
