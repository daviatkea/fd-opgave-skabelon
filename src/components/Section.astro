---
const { theme = "default", tag, ...props } = Astro.props;
const Tag = tag ?? "section";
const isHeader = tag === "header";
---

<Tag
  class:list={["section", { header: isHeader }]}
  data-theme={theme}
  {...props}
>
  <div>
    <slot />
  </div>
</Tag>

<style>
  [data-theme] {
    --theme: attr(data-theme type(<custom-ident>));
  }
  .section {
    grid-column: full;
    display: grid;
    grid-template-columns: subgrid;
    padding-block: 6rem;
    &.header {
      padding-block-end: 9rem;
    }
    > div {
      grid-column: content;
    }
  }

  [data-theme="dark"] {
    background: var(--color-neutrals-900);
    color: contrast-color(var(--color-neutrals-900));
  }
  [data-theme="muted"] {
    background: var(--color-neutrals-200);
    color: var(--color-neutrals-900);
  }
  [data-theme="banner"] {
    background: linear-gradient(
      180deg,
      var(--color-surface-primary) 66%,
      var(--color-neutrals-100)
    );
    color: var(--color-neutrals-900);
  }
</style>
