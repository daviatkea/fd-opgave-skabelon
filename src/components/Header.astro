---
import Logo from "./Logo.astro";
import Nav from "./Nav.astro";
import Popover from "./Popover.astro";
import LoginForm from "./LoginForm.astro";
---

<header>
  <div>
    <Logo />
    <Nav />
    <Popover label="Login" id="login">
      <LoginForm />
    </Popover>
  </div>
</header>

<style>
  :global(html) {
    container: doc / scroll-state;
  }
  header {
    background: #181818;
    position: sticky;
    inset-block-start: 0;
    z-index: 100;
    transition: translate 0.3s;
    view-transition-name: header;
    @container scroll-state(scrolled: bottom) {
      translate: 0 -100%;
    }
  }
  div {
    display: grid;
    grid: auto / 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
    padding-block: 1rem;
  }

  div > :global(button) {
    justify-self: end;
  }

  @media (width < 48rem) {
    div {
      grid-template-columns: 1fr auto;
    }

    div > :global(nav) {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }
</style>
